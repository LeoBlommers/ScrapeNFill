[DIRECTORIES]
input = <add input directory here>
output = <add output directory here>

[TEMPLATE]
template = <add path to template here>

[LLM]
provider = CHATGPT

[CHATGPT]
model = gpt-5.4-mini
api_key = <add chatgpt api key here>

[MISTRAL]
model = gpt-5.4-mini
api_key = <add mistral api key here>

[GEMINI]
model = gemini-3.5-flash
api_key = <add gemini api key here>

[CLAUDE]
model = claude-sonnet-4-20250514
api_key = <add claude api key here>

[OLLAMA]
model = qwen3:32b
url = <add ollama url here>

[PROCESSING]
max_concurrent = 5